# 复制为 apps/api/.env 后按需修改（.env 已被 git 忽略）
#
# Windows 等局域网电脑用浏览器打开的是 http://<Mac的IP>:5173，
# 浏览器发出的 Origin 是 Mac 地址而不是客户端 IP（例如不是 10.65.166.87）。
# 下面正则匹配 10.65.0.0/16 网段内任意 IP 的 Vite 开发端口。
CORS_ORIGIN_REGEX=^http://10[.]65[.]\d{1,3}[.]\d{1,3}:5173$

# 飞书企业自建应用：开启后进程内启动长连接客户端（需能访问公网 open.feishu.cn）
# FEISHU_ENABLED=true
# FEISHU_APP_ID=cli_xxxxxxxx
# FEISHU_APP_SECRET=xxxxxxxx
# FEISHU_DOMAIN=https://open.feishu.cn
# FEISHU_INSECURE_SSL=false

{
  "name": "banking-budget-ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "dev:backend:lan": "cd ../api && if [ -x ../../.venv/bin/python ]; then ../../.venv/bin/python run_server.py --reload --host 0.0.0.0 --port 8009; elif command -v uv >/dev/null 2>&1; then uv run python run_server.py --reload --host 0.0.0.0 --port 8009; else python3 run_server.py --reload --host 0.0.0.0 --port 8009; fi",
    "build": "vite build",
    "preview": "vite preview",
    "test:view-model": "playwright test --config=playwright.view-model.config.ts --reporter=list",
    "e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^2.1.7",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}

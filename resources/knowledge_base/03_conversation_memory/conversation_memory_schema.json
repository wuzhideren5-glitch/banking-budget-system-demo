{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ConversationMemoryRecord",
  "type": "object",
  "required": [
    "memory_id",
    "session_id",
    "created_at",
    "intent",
    "user_question",
    "final_requirement",
    "pivot_config",
    "sql_executed",
    "analysis_summary",
    "user_feedback",
    "embedding_text"
  ],
  "properties": {
    "memory_id": { "type": "string" },
    "session_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "intent": { "type": "string" },
    "user_question": { "type": "string" },
    "clarification_rounds": { "type": "integer", "minimum": 0 },
    "final_requirement": {
      "type": "object",
      "properties": {
        "time_period": { "type": "string" },
        "business_scope": { "type": "array", "items": { "type": "string" } },
        "comparison_type": { "type": "string" },
        "granularity": { "type": "string" }
      },
      "additionalProperties": true
    },
    "pivot_config": {
      "type": "object",
      "properties": {
        "rows": { "type": "array", "items": { "type": "string" } },
        "columns": { "type": "array", "items": { "type": "string" } },
        "pages": { "type": "array", "items": { "type": "string" } },
        "filters": { "type": "object" }
      },
      "additionalProperties": true
    },
    "sql_executed": { "type": "string" },
    "analysis_summary": { "type": "string" },
    "user_feedback": {
      "type": "object",
      "properties": {
        "satisfied": { "type": "boolean" },
        "comment": { "type": "string" }
      },
      "required": ["satisfied"]
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "embedding_text": { "type": "string" }
  },
  "additionalProperties": true
}
